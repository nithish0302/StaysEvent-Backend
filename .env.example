# Copy to .env and fill in real values. Never commit the actual .env file
# (it's already gitignored) — this file only documents what's required.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Exact origin of the deployed frontend, no trailing slash. Used for CORS
# and for the post-Google-login redirect. Example: https://stayevents.app
CLIENT_URL=

# ── Database ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or any reachable MongoDB instance).
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────────────────────────
# Long, random, production-only secrets — do NOT reuse the values from local
# dev or from the test suite's fallback secret. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────
# From the Google Cloud Console credentials page for this OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be this backend's own public URL + /api/auth/google/callback, and
# must be registered as an authorized redirect URI in the same Google Cloud
# Console client, or Google will refuse the login. Example:
#   https://api.stayevents.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# ── Email (password reset / booking confirmation mail) ──────────────────
# A Gmail account with an App Password (not the regular account password —
# Gmail blocks plain password SMTP auth). Generate one under Google Account
# → Security → 2-Step Verification → App passwords.
MAIL_USER=
MAIL_PASS=

# ── Payments (Razorpay) ──────────────────────────────────────────────────
# Use LIVE keys for production, not the test/sandbox keys used in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── One-shot admin bootstrap script (scripts/createAdmin.js) ────────────
# Optional — only read when you actually run that script. Without these it
# falls back to a well-known local-dev default, which the script refuses to
# use against NODE_ENV=production.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
